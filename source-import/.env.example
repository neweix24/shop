# Shop runtime and database. Configure only in protected server secrets.
DATABASE_URL=

# Neweix Account first-party identity contract.
# Configure only after Account enables OIDC and registers this Shop client.
ACCOUNT_OIDC_ISSUER=
ACCOUNT_OIDC_AUDIENCE=
ACCOUNT_OIDC_CLIENT_ID=
ACCOUNT_OIDC_CLIENT_SECRET=
ACCOUNT_OIDC_REDIRECT_URI=
ACCOUNT_OIDC_JWKS_URL=

# Eixon is the only approved Shop checkout payment authority.
EIXON_API_BASE_URL=
EIXON_SHOP_CLIENT_ID=
EIXON_SHOP_CLIENT_SECRET=
EIXON_WEBHOOK_SECRET=

# Pathao delivery adapter. Keep credentials server-side.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_BASE_URL=

# Approved Neweix notification service.
NEWEIX_NOTIFICATION_API_BASE_URL=
NEWEIX_NOTIFICATION_CLIENT_ID=
NEWEIX_NOTIFICATION_CLIENT_SECRET=

# Never put secrets or server-only values in VITE_* variables.

# Public Shop API base URL (no secrets)
VITE_SHOP_API_URL=https://grhybvlhdnzlopwbaqun.supabase.co/functions/v1/shop-api
