{
  "name": "neweix-shop-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.11.0"
  },
  "workspaces": [
    "apps/api",
    "apps/storefront"
  ],
  "scripts": {
    "check": "npm run check --workspace @neweix/shop-api && npm run check --workspace @neweix/shop-web",
    "test": "npm run test --workspace @neweix/shop-api",
    "build:api": "npm run build --workspace @neweix/shop-api",
    "build:web": "npm run build --workspace @neweix/shop-web",
    "build:worker": "npm run build:worker --workspace @neweix/shop-web"
  }
}
